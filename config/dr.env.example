# Odoo DR configuration — read by every script in scripts/.
# Copy to /etc/odoo-dr/dr.env  (owner root, mode 600) and fill in your values.
# Passwords never go here: they live in ~/.pgpass (see docs/02-build-guide.md).

# ---- publisher (production PostgreSQL, e.g. Amazon RDS)
# Public endpoint:  PUB_HOST=<rds-endpoint>.rds.amazonaws.com  PUB_PORT=5432
# Private RDS (recommended, see config/dr-pg-tunnel.service):  PUB_HOST=127.0.0.1  PUB_PORT=15432
PUB_HOST=127.0.0.1
PUB_PORT=15432
TUNNEL_UNIT=dr-pg-tunnel     # systemd unit the window restarts when the tunnel is down; empty = no tunnel
DB_NAME=erp
DB_OWNER=odoo                # owner of the replicated database (new sequences / views get this owner)
TOOLS_DB=dr_tools            # helper database on DR for the schema sync (dblink); keeps $DB_NAME identical to prod
REPL_USER=dr_replicator
PUB_NAME=erp_dr_pub
SUB_NAME=erp_dr_sub
SLOT_NAME=erp_dr_slot

# ---- production application server (read-only access for file sync)
PROD_SSH=ubuntu@app.example.com
PROD_SSH_PORT=22
SSH_KEY=/home/admin/.ssh/id_ed25519
KNOWN_HOSTS=/home/admin/.ssh/known_hosts

# ---- paths (identical on production and DR)
ODOO_ROOT=/opt/odoo18
ENTERPRISE_DIR=/opt/odoo18/addons-enterprise
CUSTOM_DIR=/opt/odoo18/addons-custom
FILESTORE_DIR=/opt/odoo18/.local/share/Odoo/filestore/erp
ODOO_USER=odoo
ODOO_GROUP=odoo

# ---- custom modules (git)
GIT_BRANCH=main
# deployed = the commit production runs (read from $CUSTOM_DIR/.deployed-commit on prod)
# main     = the tip of $GIT_BRANCH
GIT_TARGET=deployed

# ---- tuning
BW=400            # rsync limit in KB/s (0 = unlimited)
MAX_WAIT=2700     # seconds a replication window waits for catch-up
LOG_DIR=/var/log/odoo-dr
ALERTS=/var/log/odoo-dr/ALERTS.log   # every alert of every script, one line each (also syslog tag odoo-dr)
PAUSE_FLAG=/etc/odoo-dr/paused       # if this file exists, replication windows are skipped (maintenance, failover)
