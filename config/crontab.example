# root crontab on the DR server  (sudo crontab -e)
# Each script logs to /var/log/odoo-dr/, holds a lock so runs never overlap, and exits non-zero on failure.
# Alerts from every script also go to /var/log/odoo-dr/ALERTS.log and syslog (tag odoo-dr).

# files + modules from production, every morning before working hours
0 6 * * * timeout 12h nice -n 10 ionice -c3 /opt/odoo-dr/scripts/dr-daily-sync.sh > /dev/null 2>&1

# database: hourly replication window (schema sync, enable, catch up, sync sequences, disable)
0 * * * * timeout 55m /opt/odoo-dr/scripts/dr-repl-window.sh > /dev/null 2>&1

# nightly full schema comparison production vs DR (safety net for the hourly schema sync)
30 2 * * * timeout 30m nice -n 10 /opt/odoo-dr/scripts/dr-schema-diff.sh > /dev/null 2>&1
